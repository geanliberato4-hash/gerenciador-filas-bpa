{
  "rules": {
    ".read": false,
    ".write": false,

    "unidades": {
      "$unidade": {

        "filas": {
          ".read": true,

          "$fila": {
            ".write": "auth != null && auth.token.email === 'gean.liberato.4@gmail.com'",
            ".validate": "newData.hasChildren(['nome', 'ativa'])",

            "nome": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "ativa": {
              ".validate": "newData.isBoolean()"
            },
            "ordem": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },

        "guiches": {
          ".read": true,

          "$guiche": {
            ".write": "auth != null && auth.token.email === 'gean.liberato.4@gmail.com'",
            ".validate": "newData.hasChildren(['nome', 'ativo'])",

            "nome": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "ativo": {
              ".validate": "newData.isBoolean()"
            },
            "ordem": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },

        "senhas": {
          ".read": true,
          ".indexOn": ["status"],

          "$senhaId": {
            ".write": "data.exists() || newData.child('status').val() === 'aguardando'",
            ".validate": "newData.hasChildren(['nome', 'placa', 'atendimento', 'status'])",

            "nome": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "placa": {
              ".validate": "newData.isString() && newData.val().length <= 10 && (data.exists() || newData.val().matches(/^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$/))"
            },
            "atendimento": {
              ".validate": "newData.isString() && root.child('unidades').child($unidade).child('filas').child(newData.val()).exists()"
            },
            "status": {
              ".validate": "newData.val() === 'aguardando' || newData.val() === 'chamando'"
            },
            "criadoEm": {
              ".validate": "newData.isNumber() && (data.exists() || (newData.val() >= now - 600000 && newData.val() <= now + 600000))"
            },
            "chamadoEm": {
              ".validate": "newData.isNumber() && newData.val() <= now + 600000"
            },
            "guiche": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "$outro": {
              ".validate": false
            }
          }
        },

        "config": {
          ".read": true,

          "recado": {
            ".write": "auth != null && auth.token.email === 'gean.liberato.4@gmail.com'",
            ".validate": "newData.hasChildren(['texto', 'ativo'])",
            "texto": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "ativo": { ".validate": "newData.isBoolean()" },
            "em": { ".validate": "newData.isNumber()" },
            "$outro": { ".validate": false }
          },
          "testeTv": {
            ".write": "auth != null && auth.token.email === 'gean.liberato.4@gmail.com'",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "testeTvOk": {
            ".write": true,
            ".validate": "newData.hasChildren(['em', 'som'])",
            "em": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "som": { ".validate": "newData.isBoolean()" },
            "$outro": { ".validate": false }
          }
        },

        "midia": {
          ".read": true,

          "$tela": {
            ".write": "auth != null && auth.token.email === 'gean.liberato.4@gmail.com'",
            ".validate": "($tela === 'totem' || $tela === 'painel' || $tela === 'admin' || $tela === 'tv') && newData.hasChildren(['versao', 'tipo'])",
            "versao": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "tipo": { ".validate": "newData.isString() && (newData.val().beginsWith('image/') || newData.val().beginsWith('video/'))" },
            "nome": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "tamanho": { ".validate": "newData.isNumber() && newData.val() <= 25000000" },
            "em": { ".validate": "newData.isNumber()" },
            "$outro": { ".validate": false }
          }
        },

        "midiaDados": {
          ".read": true,

          "$tela": {
            ".write": "auth != null && auth.token.email === 'gean.liberato.4@gmail.com'",
            ".validate": "($tela === 'totem' || $tela === 'painel' || $tela === 'admin' || $tela === 'tv') && newData.hasChildren(['versao', 'total', 'tipo'])",
            "versao": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 80" },
            "tipo": { ".validate": "newData.isString()" },
            "partes": {
              "$i": { ".validate": "newData.isString() && newData.val().length <= 600000" }
            },
            "$outro": { ".validate": false }
          }
        },

        "historico": {
          ".read": true,
          ".indexOn": ["finalizadoEm"],

          "$registroId": {
            ".write": "root.child('unidades').child($unidade).child('filas').exists()",
            ".validate": "newData.hasChildren(['nome', 'placa'])"
          }
        }
      }
    }
  }
}
